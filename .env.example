# =============================================================================
# PROJECT ATLAS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Development (SQLite - local file)
DATABASE_URL=sqlite:///./atlas.db

# Production (PostgreSQL on Railway)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# JWT token expiry (hours)
JWT_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# WHATSAPP CLOUD API (Official Meta Integration)
# -----------------------------------------------------------------------------
# Get these from Meta for Developers: https://developers.facebook.com/
# 1. Create a Meta Business account
# 2. Create a WhatsApp Business app
# 3. Get your access token and phone number ID

# Permanent access token (from System Users in Business Settings)
WHATSAPP_TOKEN=your-whatsapp-access-token

# Phone Number ID (from WhatsApp > API Setup in your app)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Webhook verification token (you create this - any random string)
WHATSAPP_VERIFY_TOKEN=smartbursar_verify_2026

# App Secret (REQUIRED for webhook signature verification)
# Get from: developers.facebook.com > Your App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=your-app-secret-from-meta

# -----------------------------------------------------------------------------
# LEGACY: TWILIO (Deprecated - keeping for reference)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# -----------------------------------------------------------------------------
# PHASE 2: AI (Leave empty for Phase 1)
# -----------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# SUPER ADMIN (First user created on startup)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@atlas.com
SUPER_ADMIN_PASSWORD=change-this-password

# -----------------------------------------------------------------------------
# APP SETTINGS
# -----------------------------------------------------------------------------
# Default country for phone number parsing (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=NG

# Environment: development, staging, production
ENVIRONMENT=development

# Enable mock mode (prints messages instead of sending)
MOCK_MODE=true

# Enable WhatsApp Web mode (uses pywhatkit, requires browser)
# Set to true and MOCK_MODE=false to send real WhatsApp messages
WHATSAPP_MODE=false
