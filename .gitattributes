# Force LF line endings for text files (cross-platform: Windows dev → Linux prod)
* text=auto eol=lf

# Python files
*.py text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Shell scripts (must be LF for Linux)
*.sh text eol=lf

# Binary files (don't modify)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
