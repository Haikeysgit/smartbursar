{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "startCommand": "python railway_runner.py",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300
    },
    "plugins": {
        "postgresql": {
            "enabled": true
        }
    }
}